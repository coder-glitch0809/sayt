# Server porti (production). Dev rejimda (npm run dev) API_PORT ishlatiladi.
PORT=5000
API_PORT=5000

# Birinchi ishga tushirishda admin paroli shu qiymatdan olinadi.
# Keyin parolni admin paneldagi "Xavfsizlik" bo'limidan o'zgartiring.
ADMIN_PASSWORD=admin123

# JWT uchun maxfiy kalit. Bo'sh qoldirilsa, avtomatik yaratilib data/auth.json ga saqlanadi.
JWT_SECRET=

# Frontend boshqa domenda bo'lsa (masalan Vercel), shu yerga yozing. Vergul bilan bir nechta.
CORS_ORIGIN=http://localhost:5173

# --- Hosting (Render) ---
# Bo'lsa: kontent, xabarlar va parol MongoDB'da saqlanadi (aks holda server/data dagi fayllarda)
MONGODB_URI=
# MONGODB_URI bo'lsa yuklangan rasmlar ham MongoDB'da (GridFS) saqlanadi.
# Ixtiyoriy: rasmlarni Cloudinary'da saqlash uchun (O'zbekistondan ro'yxatdan o'tish bloklangan)
CLOUDINARY_URL=
